<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Power AI</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
        body { background-color: #000000; color: #ffffff; display: flex; height: 100vh; overflow: hidden; }

        /* Sidebar Styles */
        #sidebar { width: 280px; background-color: #0d0d0d; height: 100%; display: flex; flex-direction: column; position: fixed; left: -280px; top: 0; transition: left 0.3s ease; z-index: 100; border-right: 1px solid #1a1a1a; padding: 15px; }
        #sidebar.open { left: 0; }
        .sidebar-header { font-size: 1.3rem; font-weight: bold; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center; }
        .menu-item { display: flex; align-items: center; gap: 12px; padding: 12px; border-radius: 8px; color: #ececec; cursor: pointer; font-size: 0.95rem; }
        .menu-item:hover { background-color: #1a1a1a; }
        .recents-title { color: #8e8e93; font-size: 0.8rem; margin: 20px 0 10px 10px; font-weight: 600; }
        .chat-history { flex: 1; overflow-y: auto; }
        .history-item { padding: 10px 12px; border-radius: 8px; color: #d1d1d6; font-size: 0.9rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; cursor: pointer; }
        .history-item:hover { background-color: #1a1a1a; }
        .user-profile { display: flex; align-items: center; gap: 10px; padding: 12px; border-top: 1px solid #1a1a1a; margin-top: auto; }
        .avatar { width: 32px; height: 32px; background: #3a3a3c; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: bold; }

        /* Main Overlay */
        #overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); display: none; z-index: 90; }

        /* Main Content */
        #main-content { flex: 1; display: flex; flex-direction: column; height: 100vh; position: relative; width: 100%; }

        /* Top Bar */
        header { display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; background: #000000; }
        .header-left { display: flex; align-items: center; gap: 12px; }
        .icon-btn { background: none; border: none; color: #ffffff; font-size: 1.2rem; cursor: pointer; width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
        .icon-btn:hover { background: #1c1c1e; }
        .get-plus-btn { background: #1c1c1e; color: #d4bbff; border: none; padding: 6px 14px; border-radius: 20px; font-size: 0.85rem; font-weight: 600; display: flex; align-items: center; gap: 6px; }

        /* Chat Area */
        #chat-container { flex: 1; overflow-y: auto; padding: 20px; display: flex; flex-direction: column; gap: 20px; }
        .welcome-screen { display: flex; flex-direction: column; justify-content: flex-end; height: 100%; gap: 12px; padding-bottom: 20px; }
        .quick-btn { display: flex; align-items: center; gap: 12px; color: #ececec; font-size: 0.95rem; padding: 8px 0; cursor: pointer; }
        .quick-btn i { font-size: 1.1rem; color: #8e8e93; width: 24px; }

        .message { display: flex; flex-direction: column; max-width: 88%; padding: 12px 16px; border-radius: 18px; font-size: 0.95rem; line-height: 1.5; }
        .user-msg { background: #2c2c2e; align-self: flex-end; color: #ffffff; border-bottom-right-radius: 4px; }
        .ai-msg { background: transparent; align-self: flex-start; color: #ececec; padding-left: 0; }

        /* Bottom Input Bar */
        #input-area { padding: 12px 16px 20px 16px; background: #000000; }
        .input-box { background: #1c1c1e; border-radius: 28px; display: flex; align-items: center; padding: 6px 12px 6px 16px; gap: 10px; }
        .plus-btn { background: none; border: none; color: #ffffff; font-size: 1.3rem; cursor: pointer; }
        textarea { flex: 1; background: transparent; border: none; outline: none; color: #ffffff; font-size: 0.95rem; resize: none; height: 24px; max-height: 100px; line-height: 24px; }
        .action-btns { display: flex; align-items: center; gap: 8px; }
        .voice-wave-btn { background: #1a73e8; color: #ffffff; border: none; width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1rem; cursor: pointer; }
    </style>
</head>
<body>

    <!-- Sidebar Overlay -->
    <div id="overlay" onclick="toggleSidebar()"></div>

    <!-- Sidebar Menu -->
    <div id="sidebar">
        <div class="sidebar-header">
            <span>Power AI</span>
            <button class="icon-btn" onclick="toggleSidebar()"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <div class="menu-item"><i class="fa-regular fa-image"></i> Images</div>
        <div class="menu-item"><i class="fa-solid fa-layer-group"></i> Library</div>
        <div class="menu-item"><i class="fa-regular fa-folder"></i> Projects</div>
        <div class="menu-item"><i class="fa-solid fa-puzzle-piece"></i> Plugins</div>

        <div class="recents-title">Recents</div>
        <div class="chat-history">
            <div class="history-item">Logo design description</div>
            <div class="history-item">Police vs BSc Nursing</div>
            <div class="history-item">व्हिडिओ स्क्रिप्ट आयडिया</div>
            <div class="history-item">मेरा प्रिय मित्र निबंध</div>
        </div>

        <div class="user-profile">
            <div class="avatar">RK</div>
            <span style="font-size: 0.9rem; font-weight: 500;">Rameshwar Kharade</span>
        </div>
    </div>

    <!-- Main Screen -->
    <div id="main-content">
        <header>
            <div class="header-left">
                <button class="icon-btn" onclick="toggleSidebar()"><i class="fa-solid fa-bars"></i></button>
                <button class="get-plus-btn"><i class="fa-solid fa-sparkles"></i> Get Plus</button>
            </div>
            <button class="icon-btn" onclick="clearChat()"><i class="fa-regular fa-pen-to-square"></i></button>
        </header>

        <div id="chat-container">
            <div class="welcome-screen" id="welcome-screen">
                <div class="quick-btn" onclick="quickSend('Create an image')"><i class="fa-regular fa-image"></i> Create an image</div>
                <div class="quick-btn" onclick="quickSend('Write or edit text')"><i class="fa-regular fa-pen-to-square"></i> Write or edit</div>
                <div class="quick-btn" onclick="quickSend('Search the web for')"><i class="fa-solid fa-globe"></i> Search the web</div>
            </div>
        </div>

        <div id="input-area">
            <div class="input-box">
                <button class="plus-btn"><i class="fa-solid fa-plus"></i></button>
                <textarea id="user-input" placeholder="Ask Power AI" rows="1"></textarea>
                <div class="action-btns">
                    <button class="voice-wave-btn" onclick="sendMessage()"><i class="fa-solid fa-arrow-up"></i></button>
                </div>
            </div>
        </div>
    </div>

    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('overlay');
            sidebar.classList.toggle('open');
            overlay.style.display = sidebar.classList.contains('open') ? 'block' : 'none';
        }

        async function sendMessage() {
            const input = document.getElementById('user-input');
            const text = input.value.trim();
            if (!text) return;

            const welcome = document.getElementById('welcome-screen');
            if (welcome) welcome.remove();

            const chatContainer = document.getElementById('chat-container');

            // User Message
            const userDiv = document.createElement('div');
            userDiv.className = 'message user-msg';
            userDiv.innerText = text;
            chatContainer.appendChild(userDiv);
            input.value = '';

            // AI Response Placeholder
            const aiDiv = document.createElement('div');
            aiDiv.className = 'message ai-msg';
            aiDiv.innerText = 'Powering response...';
            chatContainer.appendChild(aiDiv);
            chatContainer.scrollTop = chatContainer.scrollHeight;

            try {
                const response = await fetch('/chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: text })
                });
                const data = await response.json();
                aiDiv.innerText = data.reply || "काही अडचण आली.";
            } catch (e) {
                aiDiv.innerText = "सर्व्हर एरर.";
            }
            chatContainer.scrollTop = chatContainer.scrollHeight;
        }

        function quickSend(promptText) {
            document.getElementById('user-input').value = promptText;
            sendMessage();
        }

        function clearChat() {
            location.reload();
        }
    </script>
</body>
</html>

